/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; media-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto:;

/index.html
  Cache-Control: no-store

/
  Cache-Control: no-store

/en/*
  Cache-Control: no-store
/zh/*
  Cache-Control: no-store
/ru/*
  Cache-Control: no-store
/*.html
  Cache-Control: no-store
/content/*
  Cache-Control: no-store
/site-manifest.json
  Cache-Control: no-store
/robots.txt
  Cache-Control: no-store
/sitemap.xml
  Cache-Control: no-store
/public/*
  Cache-Control: no-store

/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-store

/assets/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-store

/assets/js/*
  Cache-Control: no-store
/assets/css/*
  Cache-Control: no-store
/assets/img/*
  Cache-Control: public, max-age=0, must-revalidate

/img/*
  Cache-Control: public, max-age=0, must-revalidate

/workers/*
  X-Robots-Tag: noindex

/assets/documents/*.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: noindex
