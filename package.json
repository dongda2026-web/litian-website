{
  "name": "dongda-b2b-brand-site",
  "version": "1.2.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:private-uploads": "node scripts/verify-private-uploads.mjs",
    "test:main-integration": "node scripts/verify-main-integration.mjs",
    "test:rfq-integration": "node scripts/verify-main-integration.mjs --rfq",
    "preview:procurement": "node scripts/preview-procurement.mjs",
    "build:cms-seed": "node scripts/build-cms-seed.mjs",
    "setup:cms-local": "npm run build:cms-seed && node scripts/setup-local-cms.mjs",
    "start:cms-local": "node --env-file=var/cms/service.env scripts/start-cms.mjs",
    "start:inquiry": "node --env-file-if-exists=.env server/start-inquiry-service.mjs",
    "build:content": "node scripts/build-content-index.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:company": "node scripts/build-company-data.mjs",
    "build:admin-icons": "node scripts/build-admin-icons.mjs",
    "build:sites": "node scripts/build-sites.mjs",
    "audit:launch": "node scripts/audit-launch.mjs",
    "audit:static-delivery": "node scripts/audit-static-delivery.mjs",
    "test:static-delivery": "node --test tests/static-delivery.test.mjs tests/resource-delivery.test.mjs",
    "audit:product-pages": "node scripts/audit-product-pages.mjs",
    "audit:industry-pages": "node scripts/audit-industry-pages.mjs",
    "audit:resources": "node scripts/audit-resource-pages.mjs",
    "audit:insights": "node scripts/audit-insight-pages.mjs",
    "test:insights": "node --test tests/insights.test.mjs",
    "audit:site-search": "node scripts/audit-site-search.mjs",
    "audit:accessibility": "node scripts/audit-public-accessibility.mjs",
    "audit:faq": "node scripts/audit-faq-pages.mjs",
    "audit:selection": "node scripts/audit-selection-pages.mjs",
    "test:selection": "node --test tests/selection.test.mjs",
    "audit:company": "node scripts/audit-company-pages.mjs",
    "test:company": "node --test tests/company.test.mjs",
    "audit:home-procurement": "node scripts/audit-home-procurement.mjs",
    "test:home-procurement": "node --test tests/home-procurement.test.mjs",
    "audit:public-procurement": "node scripts/audit-public-procurement.mjs",
    "test:public-procurement": "node --test tests/public-procurement.test.mjs",
    "audit:storage-notice": "node scripts/audit-storage-notice.mjs",
    "test:storage-notice": "node --test tests/storage-notice.test.mjs",
    "audit:navigation": "node scripts/audit-public-navigation.mjs",
    "test:navigation": "node --test tests/public-navigation.test.mjs",
    "test:faq": "node --test tests/faq.test.mjs",
    "test:accessibility": "node --test tests/public-accessibility.test.mjs",
    "test:site-search": "node --test tests/site-search.test.mjs",
    "test:resources": "node --test tests/resources.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "audit:publication": "node scripts/audit-publication-review.mjs",
    "audit:publication:preview": "node scripts/audit-publication-review.mjs --preview",
    "review:seed": "node scripts/seed-publication-review.mjs",
    "test:publication": "node --test tests/publication-review.test.mjs",
    "preflight:aliyun": "npm run audit:publication && npm run preflight:quality && npm run audit:publication",
    "preflight:preview": "npm run preflight:quality",
    "audit:form-feedback": "node scripts/audit-form-feedback.mjs",
    "test:form-feedback": "node --test tests/form-feedback.test.mjs",
    "audit:lead-status": "node scripts/audit-lead-status.mjs",
    "test:lead-status": "node --test tests/lead-status.test.mjs",
    "audit:motion": "node scripts/audit-public-motion.mjs",
    "test:motion": "node --test tests/public-motion.test.mjs",
    "preflight:quality": "npm run build:admin-icons && npm run build:catalog && npm run build:company && npm test && npm run build:content && npm run validate:content && npm run build:sites && npm run audit:static-delivery && npm run audit:launch && npm run audit:product-pages && npm run audit:industry-pages && npm run audit:resources && npm run audit:insights && npm run audit:site-search && npm run audit:accessibility && npm run audit:faq && npm run audit:selection && npm run audit:company && npm run audit:home-procurement && npm run audit:public-procurement && npm run audit:storage-notice && npm run audit:navigation && npm run audit:form-feedback && npm run audit:lead-status && npm run audit:motion && npm run audit:publication:preview",
    "optimize:assets": "python3 scripts/optimize-hero-assets.py",
    "preflight:wordpress": "node scripts/wordpress-theme-preflight.mjs",
    "sync:wordpress": "node scripts/sync-wordpress-theme.mjs"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "lucide": "1.53.0",
    "parse5": "8.0.1"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "css-tree": "3.2.1",
    "file-type": "22.1.1",
    "pdf-lib": "1.17.1"
  }
}
