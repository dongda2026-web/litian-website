{
  "schemaVersion": "2026-10-08-custom-v4",
  "leadTypes": ["inquiry", "quote-calculator", "ai-customer-service", "multi-product-rfq", "sample-request"],
  "required": ["type", "company", "contact", "email", "product"],
  "optional": [
    "leadId",
    "phone",
    "productId",
    "quantity",
    "quantityUnit",
    "specifications",
    "estimatedPrice",
    "notes",
    "language",
    "page",
    "timestamp",
    "transcript",
    "source",
    "website",
    "honeypot",
    "items",
    "destination",
    "deliveryWindow",
    "sampleRequest",
    "customization"
  ],
  "limits": {
    "company": 120,
    "contact": 120,
    "email": 160,
    "phone": 80,
    "product": 160,
    "productId": 80,
    "quantity": 80,
    "specifications": 1200,
    "notes": 2400,
    "page": 500
  },
  "fallback": {
    "salesEmail": "ynakobka@dongdaltd.com",
    "localStorageKey": "dongda_receipts",
    "legacyLocalStorageKey": "dongda_inquiries",
    "receiptsOnly": true
  },
  "reception": {
    "requiredResponseFields": ["ok", "persisted", "leadId"],
    "idempotencyHeader": "Idempotency-Key",
    "leadIdPattern": "^DD-[A-Z0-9-]{8,80}$",
    "successRequiresDurableCommit": true
  }
}
